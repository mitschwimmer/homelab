vault {
  address = "https://${openbao_ip}:8200"
  ca_cert = "/var/lib/openbao-auth/server.crt"
  retry {
    num_retries = 0
  }
}

auto_auth {
  method "approle" {
    config = {
      role_id_file_path = "/var/lib/openbao-auth/role-id"
      secret_id_file_path = "/var/lib/openbao-auth/secret-id"
      # The protected, per-workload enrollment volume survives a host reboot.
      remove_secret_id_file_after_reading = false
    }
  }
}

template_config {
  static_secret_render_interval = "5m"
}

${templates}
