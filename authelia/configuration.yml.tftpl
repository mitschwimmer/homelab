server:
  address: tcp://0.0.0.0:9091/
  endpoints:
    authz:
      forward-auth:
        implementation: ForwardAuth

log:
  level: info

authentication_backend:
  file:
    path: /secrets/users.yml
    watch: true

access_control:
  default_policy: deny
  rules:
    - domain: ${base_domain}
      resources:
        - '^/private$'
      policy: two_factor

session:
  cookies:
    - domain: ${base_domain}
      authelia_url: https://auth.${base_domain}
      default_redirection_url: https://${base_domain}

storage:
  local:
    path: /data/db.sqlite3

notifier:
%{ if smtp_enabled ~}
  smtp:
    address: ${jsonencode(smtp_address)}
    username: ${jsonencode(smtp_username)}
    sender: ${jsonencode(smtp_sender)}
    startup_check_address: ${jsonencode(smtp_check_address)}
%{ else ~}
  filesystem:
    filename: /data/notification.txt
%{ endif ~}
