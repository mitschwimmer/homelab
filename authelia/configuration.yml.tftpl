server:
  address: tcp://0.0.0.0:9091/

log:
  level: info

authentication_backend:
  file:
    path: /var/lib/homelab-secrets/users.yml
    watch: true

# Authelia rejects an implicit deny policy without rules, even when Caddy
# uses only OIDC. This rule is not a second proxy gate for Grafana.
access_control:
  default_policy: deny
  rules:
    - domain: grafana.${base_domain}
      subject: 'group:admins'
      policy: two_factor
%{ if pi_enabled ~}
    - domain: ${pi_hostname}
      subject: 'group:ai-users'
      policy: two_factor
%{ endif ~}

session:
  cookies:
    - domain: ${base_domain}
      authelia_url: https://auth.${base_domain}
      default_redirection_url: https://grafana.${base_domain}

storage:
  local:
    path: /data/db.sqlite3

telemetry:
  metrics:
    # Prometheus scrapes this port on the private Incus bridge; Caddy does not publish it.
    enabled: true
    address: tcp://0.0.0.0:9959/metrics

identity_providers:
  oidc:
    # Private RSA key supplied through the secret volume; Authelia signs ID tokens.
    jwks:
      - key: {{ secret "/var/lib/homelab-secrets/oidc_jwks" | mindent 10 "|" | msquote }}
    # Only members of the existing admins group may complete Grafana's OIDC flow.
    # Deny by default and require a second factor even for authenticated users.
    authorization_policies:
      grafana_admins:
        default_policy: deny
        rules:
          - subject: 'group:admins'
            policy: two_factor
%{ if openwebui_enabled ~}
      ai_users:
        default_policy: deny
        rules:
          - subject: 'group:ai-users'
            policy: two_factor
%{ endif ~}
    # Grafana reads the username, email, and group for its local admin role
    # from the ID token, so include these claims there explicitly.
    claims_policies:
      grafana:
        id_token: ['email', 'name', 'groups', 'preferred_username']
%{ if openwebui_enabled ~}
      openwebui:
        id_token: ['email', 'name', 'groups', 'preferred_username']
%{ endif ~}
    clients:
      - client_id: grafana-homelab
        client_name: Grafana
        # Authelia stores a hash; Grafana reads the matching plaintext secret privately.
        client_secret: '{{ secret "/var/lib/homelab-secrets/grafana_client_secret_hash" }}'
        authorization_policy: grafana_admins
        claims_policy: grafana
        # Bind the authorization code to Grafana's login attempt using SHA-256 PKCE.
        require_pkce: true
        pkce_challenge_method: S256
        # Only Grafana's OAuth callback can receive the authorization code.
        redirect_uris:
          - https://grafana.${base_domain}/login/generic_oauth
        scopes: ['openid', 'profile', 'groups', 'email']
        # Browser login uses the authorization code flow, never an implicit token.
        response_types: ['code']
        grant_types: ['authorization_code']
        # Grafana does not need signed access-token or userinfo responses;
        # the ID token remains signed by the JWKS key above.
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
        # Grafana authenticates to the token endpoint with HTTP Basic credentials.
        token_endpoint_auth_method: client_secret_basic
%{ if openwebui_enabled ~}
      - client_id: openwebui-homelab
        client_name: Open WebUI
        client_secret: '{{ secret "/var/lib/homelab-secrets/openwebui_client_secret_hash" }}'
        public: false
        authorization_policy: ai_users
        claims_policy: openwebui
        require_pkce: true
        pkce_challenge_method: S256
        redirect_uris:
          - https://${openwebui_hostname}/oauth/oidc/callback
        scopes: ['openid', 'profile', 'groups', 'email']
        response_types: ['code']
        grant_types: ['authorization_code']
        access_token_signed_response_alg: none
        userinfo_signed_response_alg: none
        token_endpoint_auth_method: client_secret_basic
%{ endif ~}

notifier:
%{ if smtp_enabled ~}
  smtp:
    address: ${jsonencode(smtp_address)}
    username: ${jsonencode(smtp_username)}
    sender: ${jsonencode(smtp_sender)}
    startup_check_address: ${jsonencode(smtp_check_address)}
%{ else ~}
  filesystem:
    filename: /data/notification.txt
%{ endif ~}
