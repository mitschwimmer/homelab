{
    metrics
}

${base_domain} {
    handle /private {
        route {
            forward_auth http://${authelia_ip}:9091 {
                uri /api/authz/forward-auth
                copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
            }
            respond "authenticated" 200
        }
    }

    handle /health {
        respond "ok" 200
    }

    handle {
        respond "Caddy is running" 200
    }
}

auth.${base_domain} {
    reverse_proxy http://${authelia_ip}:9091
}

grafana.${base_domain} {
    forward_auth http://${authelia_ip}:9091 {
        uri /api/authz/forward-auth
    }
    reverse_proxy http://${grafana_ip}:3000
}

# Listen on the internal bridge too; do not forward this port from the router.
:9180 {
    metrics /metrics
}
