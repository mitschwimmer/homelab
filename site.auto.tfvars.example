# Copy to site.auto.tfvars and set values for this IncusOS installation.
# These are example values. Check every value against the fresh installation
# and reserve addresses before applying; do not reuse old OpenTofu state.
# HCL accepts comments inside object values, so each input is documented here.
site = {
  # Incus client alias from `incus remote list` (already authenticated).
  incus_remote   = "measerve"

  # Existing pool from `incus storage list measerve:`.
  storage_pool   = "local"

  # Existing managed bridge from `incus network list measerve:`. Inspect its
  # subnet with `incus network show measerve:incusbr0`.
  private_bridge = "incusbr0"

  # Physical host interface connected to the LAN; inspect `incus network list
  # measerve:`. The Caddy macvlan NIC attaches to this interface.
  lan_parent     = "enp129s0"

  # Unique locally administered unicast MAC for Caddy's LAN NIC. Reserve a
  # fixed LAN address for it in the router's DHCP settings; keep this MAC
  # unchanged when reusing the existing DHCP reservation.
  caddy_mac      = "02:00:00:ca:dd:01"

  # Free address on the private bridge's IPv4 subnet, reserved for Authelia.
  # See the README for the allocation and DHCP lease checks before choosing.
  authelia_ip    = "10.221.180.10"

  # Free address on the same private bridge for the OpenBao system container.
  openbao_ip     = "10.221.180.13"

  # Reserve two more unused IPv4 addresses on the private bridge, as above.
  prometheus_ip = "10.221.180.11"
  grafana_ip    = "10.221.180.12"

  # `dns.domain` from `incus network show measerve:incusbr0`.
  private_dns_domain = "incus"

  # Domain you control, with public DNS for it and auth.<base_domain> both
  # pointing to the router's public address.
  base_domain    = "mitschwimmer.de"
}

# Add other exporters only after their services exist. For example, once
# Immich enables telemetry, add jobs for its API and microservices ports:
# prometheus_extra_targets = [
#   { job_name = "immich-api", target = "10.221.180.20:8081", metrics_path = "/metrics" },
#   { job_name = "immich-microservices", target = "10.221.180.20:8082", metrics_path = "/metrics" },
# ]

# To collect IncusOS instance and host metrics, follow the Incus TLS setup in
# the README, then set the reachable host:port and its certificate SAN name:
# incus_metrics = { target = "192.168.1.100:8443", server_name = "measerve" }
